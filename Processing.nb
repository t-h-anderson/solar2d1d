Cell[BoxData[{
 RowBox[{
  RowBox[{"range", "=", "All"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"filter", "=", 
   RowBox[{"1", "+", 
    RowBox[{
     RowBox[{"(", " ", 
      RowBox[{"yvals", "-", 
       RowBox[{"Abs", "[", "yvals", "]"}]}], ")"}], "/", "2"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{
    RowBox[{"data", "[", 
     RowBox[{"[", 
      RowBox[{"3", ",", "range"}], "]"}], "]"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"data", "[", 
       RowBox[{"[", 
        RowBox[{"7", ",", "range"}], "]"}], "]"}], "-", "0.7"}], ")"}], "*", 
    "filter"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"kappa", "=", 
   RowBox[{"data", "[", 
    RowBox[{"[", 
     RowBox[{"4", ",", "range"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"phi", "=", 
   RowBox[{"data", "[", 
    RowBox[{"[", 
     RowBox[{"5", ",", "range"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"alpha", "=", 
   RowBox[{"2", "^", 
    RowBox[{"data", "[", 
     RowBox[{"[", 
      RowBox[{"6", ",", "range"}], "]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Eg0", "=", 
   RowBox[{
    RowBox[{"data", "[", 
     RowBox[{"[", 
      RowBox[{"7", ",", "range"}], "]"}], "]"}], "*", "filter"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nmLi", "=", 
   RowBox[{"data", "[", 
    RowBox[{"[", 
     RowBox[{"8", ",", "range"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Eg", "[", "z_", "]"}], ":=", 
  RowBox[{"Eg0", "-", "A", "+", 
   RowBox[{"A", "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"0.5", "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{
            RowBox[{"2", "*", "Pi", "*", "z", "*", 
             RowBox[{"kappa", "/", "nmLi"}]}], "-", 
            RowBox[{"2", "*", "Pi", "*", "phi"}]}], "]"}], "+", "1"}], 
         ")"}]}], ")"}], "^", "alpha"}], ")"}]}]}]}]}], "Input",
